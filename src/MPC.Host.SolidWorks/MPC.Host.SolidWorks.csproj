<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Prefer32bit>false</Prefer32bit>

    <OutputType>Library</OutputType>
    <RootNamespace>MPC.Host.SolidWorks</RootNamespace>
    <AssemblyName>MPC.Host.SolidWorks</AssemblyName>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RegisterForComInterop>false</RegisterForComInterop>
  </PropertyGroup>

  <PropertyGroup>
    <SolidWorksApiRedistPath Condition="'$(SolidWorksApiRedistPath)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksApiRedistPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiRedistPath)\SolidWorks.Interop.sldworks.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>

    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiRedistPath)\SolidWorks.Interop.swconst.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>

    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiRedistPath)\SolidWorks.Interop.swpublished.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MPC.Contracts\MPC.Contracts.csproj" />
  </ItemGroup>

</Project>
